<Window x:Class="Notifications.Sample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:enum="clr-namespace:Notifications.Enums;assembly=Notifications"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ntf="https://github.com/notifications/xaml/controls"
        Title="WpfNotifications 示例"
        Width="1100"
        Height="720"
        MinWidth="820"
        MinHeight="560"
        Background="#FFF3F4F6"
        mc:Ignorable="d"
        >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <GroupBox Margin="12"
                  Header="通知预览">

            <ntf:NotificationArea x:Name="notificationArea"
                                  Panel.ZIndex="9999"
                                  AllowRemovingPermanentOnOverflow="{Binding ElementName=AllowRemovingPermanentOnOverflow, Path=IsChecked}"
                                  Identifier="main_window"
                                  MaxItems="3"
                                  NotificationMargin="10 10 10 0"
                                  ReverseOrder="{Binding ElementName=ReverseOrder, Path=IsChecked}"
                                  />
        </GroupBox>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <GroupBox Margin="12,0,6,0"
                      Header="显示选项">
                <StackPanel>

                    <CheckBox x:Name="isInWindow"
                              Margin="20,20,0,0"
                              Content="显示在当前窗口（取消后使用桌面 Overlay）"
                              IsChecked="True"
                              />
                    <ComboBox Name="comb"
                              Width="200"
                              Margin="20,10,0,0"
                              HorizontalAlignment="Left"
                              SelectedIndex="4"
                              SelectionChanged="comb_SelectionChanged"
                              >
                        <ComboBoxItem Content="TopLeft" />
                        <ComboBoxItem Content="TopRight" />
                        <ComboBoxItem Content="TopCenter" />
                        <ComboBoxItem Content="BottomLeft" />
                        <ComboBoxItem Content="BottomRight" />
                        <ComboBoxItem Content="BottomCenter" />
                        <ComboBoxItem Content="CenterLeft" />
                        <ComboBoxItem Content="CenterRight" />
                        <ComboBoxItem Content="Center" />
                    </ComboBox>
                    <CheckBox x:Name="AllowRemovingPermanentOnOverflow"
                              Margin="20,10,0,0"
                              Content="溢出时允许移除永久通知"
                              IsChecked="True"
                              />
                    <CheckBox x:Name="ReverseOrder"
                              Margin="20,10,0,0"
                              Content="反向排列"
                              IsChecked="True"
                              />
                    <CheckBox x:Name="showCloseButton"
                              Margin="20,10,0,0"
                              Content="显示关闭按钮"
                              IsChecked="True" />
                    <CheckBox x:Name="showCountdownBar"
                              Margin="20,10,0,20"
                              Content="显示倒计时条"
                              IsChecked="True" />

                </StackPanel>
            </GroupBox>

            <UniformGrid Grid.Column="1"
                         Margin="6,0,12,0">
                <Button Margin="2"
                        Click="CustomButtonClick"
                        Content="随机自定义消息"
                        />
                <Button Margin="2"
                        Click="MessageButtonClick"
                        Content="普通消息"
                        />
                <Button Margin="2"
                        Click="MessageWithTitleButtonClick"
                        Content="标题与类型消息"
                        />
                <Button Margin="2"
                        Click="UserControlMessageButtonClick"
                        Content="UserControl 内容"
                        />
                <Button Margin="2"
                        Click="CustomNotificationButtonClick"
                        Content="永久自定义通知"
                        />
                <Button Margin="2"
                        Click="ClearButtonClick"
                        Content="清除当前目标"
                        />
            </UniformGrid>

        </Grid>

        <Border Grid.Row="2"
                Margin="12"
                Padding="10"
                Background="White"
                BorderBrush="#FFD1D5DB"
                BorderThickness="1"
                CornerRadius="4">
            <TextBlock x:Name="statusText"
                       AutomationProperties.LiveSetting="Polite"
                       Foreground="#FF374151"
                       Text="请选择选项并创建通知；显示开关仅影响之后创建的通知。"
                       TextWrapping="Wrap" />
        </Border>

    </Grid>
</Window>
